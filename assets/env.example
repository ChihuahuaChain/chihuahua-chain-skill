# Chihuahua chain (chihuahua-1): copy to .env and `source` it.
# Public endpoints rotate; if one fails, swap in another from references/network.md.
# Testnet (woofnet-6): CHAIN_ID=woofnet-6, RPC=https://testnet-rpc.chihuahua.wtf,
# REST=https://testnet-api.chihuahua.wtf, faucet https://testnet-faucet.chihuahua.wtf

CHAIN_ID=chihuahua-1
DENOM=uhuahua          # base unit; 1 HUAHUA = 1000000 uhuahua
DISPLAY_DENOM=HUAHUA
DECIMALS=6

# CometBFT RPC (tx broadcast, status, --node flag)
RPC=https://rpc.chihuahua.wtf
# WebSocket (events/subscriptions) = RPC + /websocket over wss
WS=wss://rpc.chihuahua.wtf/websocket
# Cosmos SDK REST/LCD (HTTP/JSON queries)
REST=https://api.chihuahua.wtf
# gRPC (protobuf clients, indexing)
GRPC=grpc.chihuahua.wtf:443

# Fee settings: 500uhuahua is the consensus minimum (x/feeburn min_gas_prices, v10.0.1);
# simulations underestimate, so pad the gas by 1.6
GAS_PRICES=500uhuahua
GAS_ADJUSTMENT=1.6

# Standard tx flags built from the above (for chihuahuad)
TXFLAGS="--chain-id $CHAIN_ID --node $RPC --gas auto --gas-adjustment $GAS_ADJUSTMENT --gas-prices $GAS_PRICES -y -b sync"
